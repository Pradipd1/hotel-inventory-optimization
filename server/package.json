{
  "name": "hotel-inventory-server",
  "version": "1.0.0",
  "description": "REST API for the Hotel Inventory Optimization Module",
  "type": "module",
  "main": "server.js",
  "private": true,
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon --watch . --ignore uploads --ignore .mongo-data server.js",
    "seed": "node seed/seed.js",
    "db:start": "node scripts/localMongo.js",
    "test": "vitest run"
  },
  "engines": {
    "node": ">=18.18"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cloudinary": "^2.11.0",
    "cors": "^2.8.6",
    "date-fns": "^4.4.0",
    "dotenv": "^16.6.1",
    "express": "^5.3.0",
    "express-rate-limit": "^7.5.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^8.24.9",
    "morgan": "^1.12.1",
    "multer": "^2.5.0",
    "pdfkit": "^0.20.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "mongodb-memory-server": "^10.4.3",
    "nodemon": "^3.1.14",
    "supertest": "^7.3.2",
    "vitest": "^2.1.9"
  }
}
