NODE_ENV=development
PORT=5000
# Local replica set (npm run db:start) or MongoDB Atlas, e.g.
# MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/hotel_inventory
MONGO_URI=mongodb://127.0.0.1:27017/hotel_inventory?replicaSet=rs0
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=8h
# Comma-separated list of allowed frontend origins
CLIENT_ORIGIN=http://localhost:5173
ALERT_SCAN_INTERVAL_MINUTES=60
# Set to the number of reverse proxies in front of the API (e.g. 1 on Render/Railway/Nginx)
# so rate limiting uses the real client IP. Leave empty when the API is reached directly.
TRUST_PROXY=
# Optional: store item images in Cloudinary (required on Render, whose disk is wiped on redeploy).
# Copy "API environment variable" from the Cloudinary dashboard: cloudinary://<api_key>:<api_secret>@<cloud_name>
CLOUDINARY_URL=
