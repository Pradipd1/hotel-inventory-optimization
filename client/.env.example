# Optional. Defaults to /api, proxied by Vite to http://localhost:5000 in development.
# Leave unset when the API is on the same domain (the Vercel setup). Set it only if the API is hosted elsewhere.
# VITE_API_URL=https://api.your-hotel-system.example/api
# Hide the demo account shortcuts on the login page (set to false for real deployments)
VITE_SHOW_DEMO_ACCOUNTS=true
